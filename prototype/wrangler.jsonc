/**
 * Atelier prototype — Cloudflare Workers configuration.
 *
 * Per ADR-052 (Cloudflare-primary infrastructure pivot, 2026-05-09).
 * Migration tracked at BRD-OPEN-QUESTIONS §37; this file lands as PR 1
 * (CF scaffold, no traffic) — the live deploy continues to serve from
 * Vercel until BRD §37 PR 4 (operator-driven cutover).
 *
 * Build pipeline: `next build` → `@opennextjs/cloudflare` adapter writes
 * `.open-next/worker.js` (Worker entry) + `.open-next/assets/` (static).
 *
 * Operator setup required before first deploy succeeds:
 *   1. `wrangler login` (one-time per account)
 *   2. `wrangler hyperdrive create atelier-pool --connection-string="$ATELIER_DATASTORE_URL"`
 *      then paste the returned binding id into the [[hyperdrive]] block below.
 *   3. `wrangler secret put ATELIER_OIDC_ISSUER` (and the rest per the
 *      operator runbook at docs/user/tutorials/cloudflare-bootstrap.md).
 *   4. `npm run cf:deploy` from prototype/.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-prototype",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-25",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served by Workers Static Assets binding (no separate Pages project).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Workers Observability logs (Workers tail + dashboard logs panel).
  "observability": {
    "enabled": true
  },

  // Hyperdrive binding for Postgres connection pooling to Supabase.
  // Per ADR-052: caching MUST be disabled for ADR-051 RLS correctness
  // (per-tx SET LOCAL ROLE atelier_runtime would be cached across composer
  // identities otherwise, breaking tenant isolation).
  //
  // The `id` value below is a placeholder — operator must replace with the
  // real binding id from `wrangler hyperdrive create` before first deploy.
  // Detection: deploys with the placeholder id will fail at request time
  // with "binding not found" — this is intentional, surfaces missing setup.
  "hyperdrive": [
    {
      "binding": "ATELIER_POOL",
      "id": "898cfce66f414f188129a8f9f2516a62",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],

  // SSE broadcast Durable Object (ADR-055 / G2). One DO instance per
  // project_id holds the per-project SSE fan-out. Subscribers connect via
  // /api/events?project_id=<uuid>; the route forwards to
  // env.ATELIER_BROADCAST.get(idFromName(project_id)). Publishers (MCP
  // write handlers) call publish() on the CloudflareDoBroadcastService
  // which routes through the same namespace.
  //
  // Per ADR-029 portability: the DO class is the IMPLEMENTATION; the
  // BroadcastService interface is the seam other adapters
  // (Supabase Realtime, Postgres NOTIFY) plug into.
  // Cross-Worker DO binding: the class is owned by the broadcast-worker
  // (see /broadcast-worker/wrangler.jsonc). Per CF convention, script_name
  // points at the deployed broadcast-worker so this app's binding
  // resolves to the same DO instances the broadcast-worker hosts.
  //
  // Per ADR-029 portability: the class lives behind the BroadcastService
  // seam in /scripts/coordination/adapters/cloudflare-do-broadcast.ts.
  // Swapping to Postgres NOTIFY or any other transport is a config flip
  // in mcp-deps.ts, not a CF-binding change.
  "durable_objects": {
    "bindings": [
      {
        "name": "ATELIER_BROADCAST",
        "class_name": "AtelierSseDurableObject",
        "script_name": "atelier-broadcast"
      }
    ]
  }

  // Cron triggers are owned by the separate cron-worker (see
  // /cron-worker/wrangler.jsonc) per BRD-OPEN-QUESTIONS §37 PR 2d.
  // The Worker's triggers.crons block drives CF's scheduled() handler,
  // which dispatches over HTTPS to this app's /api/cron/* route
  // handlers (verified by verifyCronRequest with CRON_SECRET). Keeping
  // cron out of this main-app wrangler.jsonc preserves independent
  // deploy lifecycles per the cron-worker top-of-file rationale.
  //
  // Schedules (mirror what cron-worker/wrangler.jsonc declares):
  //   */5 * * * *       reaper           (ARCH §6.1)
  //   */2 * * * *       mirror-delivery  (ARCH §7.4)
  //   15 * * * *        reconcile        (ARCH §6.6)
  //   */10 * * * *      triage           (ARCH §6.5.2)
  //   2-57/5 * * * *    alert-publisher  (ARCH §8) -- staggered
}
